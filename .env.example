# Copy this file to .env and fill in as needed -- backend/rag.py loads it automatically.
# Defaults below are set up for local Ollama (free, no API key needed).

# Local & free (Ollama) -- default:
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
CHAT_MODEL=llama3.1
EMBED_MODEL=nomic-embed-text

# Hosted (OpenAI) -- uncomment and fill in instead if you'd rather use OpenAI,
# including for enabling chat on the deployed Render backend (Ollama can't run there):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

LLM_TIMEOUT=60
